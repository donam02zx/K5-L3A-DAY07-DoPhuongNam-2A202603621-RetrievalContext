# Copy to .env and fill in secrets. Never commit .env.

# --- LLM controller (agent, tool calling) ---
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# --- Embedding: MUST match the Day 6 index (local, no API key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Vector store: Day 6 PostgreSQL + pgvector (docker compose in Day 6 starter/) ---
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
DB_TABLE=progit_chunks
# Day 6 index strategy to query: A = fixed_size 500/50, B = by_paragraph 800
DAY6_STRATEGY=B
